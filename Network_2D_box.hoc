  mknet_BC()
  mknet_BSC()
  mknet_OLM()
  mknet_VIPCCK()
  //mknet_VIPCRpmv()
  //mknet_VIPCRnvm()
} else if (n_neuron == 5) {
  // No VIP/CCK population
  mknet()  // go ahead and create the net!
  mknet_AAC()
  mknet_BC()
  mknet_BSC()
  mknet_OLM()
  //mknet_VIPCCK()
  mknet_VIPCRpvm()
  mknet_VIPCRnvm()
} else if (n_neuron == 6) {
  // No VIP Positive-Velocity-Modulated population
  mknet()  // go ahead and create the net!
  mknet_AAC()
  mknet_BC()
  mknet_BSC()
  mknet_OLM()
  mknet_VIPCCK()
  //mknet_VIPCRpvm()
  mknet_VIPCRnvm()
} else if (n_neuron == 7) {
  // No VIP Negative-Velocity-Modulated population
  mknet()  // go ahead and create the net!
  mknet_AAC()
  mknet_BC()
  mknet_BSC()
  mknet_OLM()
  //mknet_VIPCCK()
  mknet_VIPCRpvm()
  //mknet_VIPCRnvm()
} else {
  // All cells, all connections
  mknet()  // go ahead and create the net!
  mknet_AAC()
  mknet_BC()
  mknet_BSC()
  mknet_OLM()
  mknet_VIPCCK()
  mknet_VIPCRpvm()
  mknet_VIPCRnvm()
}

//////////////////////////////////////////////////
// Instrumentation, i.e. stimulation and recording
//////////////////////////////////////////////////

objref tvec, idvec
proc spikerecord() { local i localobj nc, nil
  print "Record real cell spikes (0 to ", ncell-1, ")..."
  tvec = new Vector()
  idvec = new Vector()
  for i=0, ncell-1 {
    nc = cells.object(i).connect2target(nil)
    nc.record(tvec, idvec, gidvec.x[i])
  }
}
spikerecord()

// Record cell voltage traces
// 1 representative trace per cell type only (index 0). All spike times still in spikes.dat.
objref pvsoma    // Representative PC
objref vAAC      // Representative AAC
objref vBC       // Representative BC
objref vBSC      // Representative BSC
objref vOLM      // Representative OLM
objref vVCCK     // Representative VIP/CCK
objref vVCR      // Representative VIP/CR
objref vVCRnvm   // Representative VIP/CRnvm

proc vrecord() {local i, gid
  print "Record example voltage traces..."
  for i=0, ncell-1 {  // loop over real cells
    gid = gidvec.x[i] // id of cell
    if (gid == iPC)                    { pvsoma  = new Vector()  pvsoma.record(&cells.object(i).soma.v(0.5)) }
    if (naacell > 0 && gid == iAAC)   { vAAC    = new Vector()  vAAC.record(&cells.object(i).soma.v(0.5)) }
    if (nbcell  > 0 && gid == iBC)    { vBC     = new Vector()  vBC.record(&cells.object(i).soma.v(0.5)) }
    if (nbscell > 0 && gid == iBSC)   { vBSC    = new Vector()  vBSC.record(&cells.object(i).soma.v(0.5)) }
    if (nolm    > 0 && gid == iOLM)   { vOLM    = new Vector()  vOLM.record(&cells.object(i).soma.v(0.5)) }
    if (nvipcck > 0 && gid == iVCCK)  { vVCCK   = new Vector()  vVCCK.record(&cells.object(i).soma.v(0.5)) }
    if (nvipcrpvm  > 0 && gid == iVCRpvm)  { vVCR    = new Vector()  vVCR.record(&cells.object(i).soma.v(0.5)) }
    if (nvipcrnvm > 0 && gid == iVCRnvm) { vVCRnvm = new Vector()  vVCRnvm.record(&cells.object(i).soma.v(0.5)) }
  }
}

vrecord()


////////////////////////////
// Simulation control
////////////////////////////

strdef fstem, path

sprint(fstem,"%s",temp_dir)

// Time parameters
tstop = SIMDUR
dt = 0.1
steps_per_ms = 10
//n=tstop*steps_per_ms
celsius = 34
// run()

// Standard initialization
stdinit()

start_wall = startsw() // Start the timer
current_wall = 0

print "--- Simulation Started ---"
printf("Total Duration: %.0f ms\n", tstop)

while (t < tstop - 0.0001) {
    // Determine the next stopping point (every 1000ms)
    step_goal = t + 50
    if (step_goal > tstop) { step_goal = tstop }
    
    // Advance the simulation to that goal
    continuerun(step_goal)
    
    // Calculate progress and time
    current_wall = startsw() - start_wall
    pct = (t / tstop) * 100
    
    // ETA calculation
    if (t > 0) {
        eta = (current_wall / t) * (tstop - t)
    } else {
        eta = 0
    }

    // Print a clean status line
    printf("Time: %6.0f/%6.0f ms | Progress: %5.1f%% | Wall Time: %6.0f s | ETA: %5.0fs\n", t, tstop, pct, current_wall, eta)    
    if (tstop - t < dt/2) { break }
}

print "--- Simulation Finished ---"
printf("Total Real-World Time: %.2f seconds\n", startsw() - start_wall)

////////////////////////////
// Report simulation results
////////////////////////////

strdef fno, cp_cmd

proc vout() { local i, j, gid, cnt localobj fo, fspk
  print "Starting vout() - saving data..."
  for j=0, ncell-1 {  // loop over real cells
    gid = gidvec.x[j] // id of cell
    cnt = 0
    if (gid == iPC)  {
      sprint(fno,"%s/pvsoma_0.dat", fstem)   fo = new File(fno)   fo.wopen()
      for i=0, pvsoma.size-1 { fo.printf("%g\n", pvsoma.x[i]) }   fo.close()
    }
    if (naacell > 0 && gid == iAAC) {
      sprint(fno,"%s/aacell_0.dat", fstem)   fo = new File(fno)   fo.wopen()
      for i=0, vAAC.size-1 { fo.printf("%g\n", vAAC.x[i]) }       fo.close()
    }
    if (nbcell > 0 && gid == iBC)  {
      sprint(fno,"%s/bcell_0.dat", fstem)    fo = new File(fno)   fo.wopen()
      for i=0, vBC.size-1 { fo.printf("%g\n", vBC.x[i]) }         fo.close()
    }
    if (nbscell > 0 && gid == iBSC) {
      sprint(fno,"%s/bscell_0.dat", fstem)   fo = new File(fno)   fo.wopen()
      for i=0, vBSC.size-1 { fo.printf("%g\n", vBSC.x[i]) }       fo.close()
    }
    if (nolm > 0 && gid == iOLM) {
      sprint(fno,"%s/olm_0.dat", fstem)       fo = new File(fno)   fo.wopen()
      for i=0, vOLM.size-1 { fo.printf("%g\n", vOLM.x[i]) }       fo.close()
    }
    if (nvipcck > 0 && gid == iVCCK) {
      sprint(fno,"%s/vipcck_0.dat", fstem)    fo = new File(fno)   fo.wopen()
      for i=0, vVCCK.size-1 { fo.printf("%g\n", vVCCK.x[i]) }     fo.close()
    }
    if (nvipcrpvm > 0 && gid == iVCRpvm) {
      sprint(fno,"%s/vipcr_0.dat", fstem)     fo = new File(fno)   fo.wopen()
      for i=0, vVCR.size-1 { fo.printf("%g\n", vVCR.x[i]) }       fo.close()
    }
    if (nvipcrnvm > 0 && gid == iVCRnvm) {
      sprint(fno,"%s/vipcrnvm_0.dat", fstem)  fo = new File(fno)   fo.wopen()
      for i=0, vVCRnvm.size-1 { fo.printf("%g\n", vVCRnvm.x[i]) } fo.close()
    }
  }
  
  // Save all spikes
  fspk = new File()
  sprint(fno, "%s/spikes.dat", fstem)
  print "Saving all spikes to ", fno
  fspk.wopen(fno)
  for i=0, tvec.size-1 {
    fspk.printf("%g %d\n", tvec.x[i], idvec.x[i])
  }
  fspk.close()

  // Copy path.txt to the result folder for convenience
  sprint(cp_cmd, "cp make_inputs_linear_track/runs_produced_2D_cond%d_pos/run_%d/path.txt %s/path.txt", learning_cond, n_runs, fstem)
  system(cp_cmd)
}
vout()

print "Job is done without Errors."

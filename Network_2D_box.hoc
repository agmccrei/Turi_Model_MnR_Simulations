// CA1 Network with grid-like inputs


// Based on Cutsuridis et al, 2009
// Hippocampus, 2009, DOI 10.1002/hipo.20661.

{load_file("nrngui.hoc")}
// nrn_load_dll("/Users/agmccrei/Library/CloudStorage/GoogleDrive-agmccrei@gmail.com/My Drive/TopolnikLab/TuriModel/246546-master/x86_64/.libs/libnrnmech.so")

print "Mechanisms loaded. Starting cell loads..."

seed1 = n_trials
seed2 = n_runs*n_trials

// CELL TYPES
{load_file("cells/pyramidal_cell.hoc")}
{load_file("cells/basket_cell.hoc")}
{load_file("cells/axoaxonic_cell.hoc")}
{load_file("cells/bistratified_cell.hoc")}
{load_file("cells/olm_cell.hoc")}
{load_file("cells/vipcck_cell.hoc")}
{load_file("cells/vipcrpvm_cell.hoc")}
{load_file("cells/vipcrnvm_cell.hoc")}
// NOISE
{load_file("cells/stim_cell_noise.hoc")}
// GRID-LIKE INPUT
{load_file("cells/stim_cell_ec.hoc")}
{load_file("cells/stim_cell_ca3.hoc")}
// SEPTUM
{load_file("cells/burst_cell.hoc")}
// MEDIAN RAPHE
{load_file("cells/stim_cell_mnr.hoc")}
// RANDOM GENERATOR
{load_file("ranstream.hoc")}  // to give each cell its own sequence generator

// Athanasia Papoutsi
func round () {
  if ($1-int($1) >= 0.5) {
    return int($1)+1
  } else {
    return int($1)
  }
}

// --- check if scalar values were inputted - if not, assign 1
if (!name_declared("scale_VIP_CR_to_OLM")) { execute("scale_VIP_CR_to_OLM = 1") }
if (!name_declared("scale_PC_to_OLM")) { execute("scale_PC_to_OLM = 1") }

// --- Sanity check: Print scale values ---
print "scale_VIP_CR_to_OLM="
print scale_VIP_CR_to_OLM
print "scale_PC_to_OLM="
print scale_PC_to_OLM

strdef my_string,temp_save1,temp_save2,temp_dir, temp_mkdir
strdef pot_file,pot_dir
objref pot_fobj

if (n_neuron==0) {
  my_string = "Control"
} else if (n_neuron==1) {
  my_string ="No_VIPcells"
} else if (n_neuron==2) {
  my_string ="No_VIPCR"
} else if (n_neuron==3) {
  my_string ="No_VIPCRtoBC"
} else if (n_neuron==4) {
  my_string ="No_VIPCRtoOLM"
} else if (n_neuron==5) {
  my_string ="No_VIPCCK"
} else if (n_neuron==6) {
  my_string ="No_VIPPVM"
} else if (n_neuron==7) {
  my_string ="No_VIPNVM"
} else if (n_neuron==8) {
  sprint(my_string, "ModulateOLM_VIPCR2OLM_%.2f_PC2OLM_%.2f", scale_VIP_CR_to_OLM, scale_PC_to_OLM)
} else if (n_neuron==9) {
  my_string ="Silenced_MnR"
} else if (n_neuron==10) {
  my_string ="Silenced_MnR_to_VCpvm"
} else if (n_neuron==11) {
  my_string ="Silenced_MnR_to_CCK_VCnvm"
}

strdef learning
learning = "2D_box"

// Condition control: 0: Novelty, 1: CFC, 2: Reintroduction, 3: Neutral
if (!name_declared("learning_cond")) { execute("learning_cond = 0") }
if (!name_declared("File")) { load_file("stdrun.hoc") }
if (learning_cond == 0) { learning = "2D_box_Novelty" }
if (learning_cond == 1) { learning = "2D_box_CFC" }
if (learning_cond == 2) { learning = "2D_box_Reintroduction" }
if (learning_cond == 3) { learning = "2D_box_Neutral" }
if (learning_cond == 4) { learning = "2D_box_Familiar2Novelty" }

sprint(temp_dir, "Simulation_Results/%s/%s/Trial_%d/Run_%d",learning,my_string,n_trials,n_runs)
sprint(temp_mkdir, "mkdir -p %s", temp_dir)
system(temp_mkdir)

TINIT    = 400
STARTDEL = 500  // msecs
THETA    = 125 // msecs (8 Hz)
GAMMA    = 25  // msecs (40 Hz)

duration = 176 // total time of "active" simulation (22000ms / 125ms)
SIMDUR = TINIT + (THETA*duration) + STARTDEL/10 // simulation duration (msecs)

//////////////////////////////////
// Step 1: Define the cell classes
//////////////////////////////////
nplf  = 49 // 7x7 grid of fields
ndend = 8
probability = 0.40 // probability of place cell formation

scale     = 1
npcell    = 130*scale
naacell   = 2*scale   
nbcell    = 8*scale   
nbscell   = 2*scale 
nolm      = 2*scale
nvipcck   = 1*scale
nvipcrpvm    = 4*scale
nvipcrnvm = 1*scale
nCA3      = nplf*ndend
nEC       = nplf*ndend
nCA3nvm   = nplf*ndend
nECnvm    = nplf*ndend
nSEP      = 10
nNOISE    = 1000
nMnR      = nplf*ndend

ncell = npcell+naacell+nbcell+nbscell+nolm+nvipcck+nvipcrpvm + nvipcrnvm// total number of cells
nstim = nCA3+nEC+nCA3nvm+nECnvm+nSEP+nNOISE+nMnR                // total number of inputs
ntot  = ncell+nstim


// Define folder of inputs
strdef tmpdir_pvm, tmpdir_nvm
sprint(tmpdir_pvm, "make_inputs_linear_track/runs_produced_2D_cond%d_pos", learning_cond)
sprint(tmpdir_nvm, "make_inputs_linear_track/runs_produced_2D_cond%d_neg", learning_cond)

//////////////////////////////////
// Entorhinal Cortex Input
//////////////////////////////////
objref index_vecEC

index_vecEC = new Vector(nEC)

//Monotonically increasing index vector initialization:
for k = 0, nEC-1 {
  index_vecEC.x[k] = k
}

objref flEC, vspkEC[nEC], vecstimEC[nEC]
flEC = new File()
strdef tmpstring1

for (i=0; i < nEC; i = i+1) { 
  sprint(tmpstring1, "%s/run_%d/g%d_EC.txt", tmpdir_pvm, n_runs, index_vecEC.x[i])
  if (flEC.ropen(tmpstring1)) {
    vspkEC[i] = new Vector()
    vspkEC[i].scanf(flEC)
    flEC.close()
  } else {
    print "Error: Could not open ", tmpstring1
    vspkEC[i] = new Vector()
  }
}

objref index_vecECnvm

index_vecECnvm = new Vector(nECnvm)


//Monotonically increasing index vector initialization:

for k = 0, nECnvm-1 {
  index_vecECnvm.x[k] = k
}


objref flECnvm, vspkECnvm[nECnvm], vecstimECnvm[nECnvm]
flECnvm = new File()
strdef tmpstring2

for (i=0; i < nECnvm; i = i+1) { 
  sprint(tmpstring2, "%s/run_%d/g%d_EC.txt", tmpdir_nvm, n_runs, index_vecECnvm.x[i])
  if (flECnvm.ropen(tmpstring2)) {
    vspkECnvm[i] = new Vector()
